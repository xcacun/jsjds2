    characterSetSelectionMode: 8
    characterSequence: "\u62AC\u6881\u5F0F\u67B6\u6784\u662F\u6728\u5934\u5EFA\u7B51\u91CC\u6700\u5E38\u7528\u7684\u627F\u91CD\u7ED3\u6784\uFF0C\u4E5F\u662F\u5927\u5B85\u9662\u8FD9\u7C7B\u5EFA\u7B51\u7684\u4E3B\u8981\u6784\u67B6\u65B9\u5F0F\uFF0C\u9760\u5C42\u5C42\u67B6\u8D77\u7684\u6728\u6881\u548C\u7ACB\u67F1\uFF0C\u6491\u8D77\u6574\u5EA7\u623F\u5B50\u7684\u5C4B\u9876\uFF0C\u4E0D\u7528\u5899\u4F53\u627F\u91CD\u3002\r\n\u5B83\u7684\u642D\u5EFA\u903B\u8F91\u7279\u522B\u6E05\u6670\uFF1A\u5148\u7ACB\u8D77\u4E00\u6839\u6839\u7AD6\u76F4\u7684\u6728\u67F1\uFF0C\u5728\u67F1\u5B50\u9876\u7AEF\u67B6\u4E0A\u6A2A\u5411\u7684\u6728\u6881\uFF0C\u4E0B\u5C42\u7684\u6881\u77ED\u3001\u4E0A\u5C42\u7684\u6881\u957F\uFF0C\u5728\u6BCF\u5C42\u6881\u7684\u4E24\u7AEF\u518D\u7ACB\u4E0A\u77EE\u4E00\u4E9B\u7684\u77ED\u67F1\uFF0C\u628A\u66F4\u957F\u7684\u6881\u67B6\u4E0A\u53BB\uFF0C\u8FD9\u6837\u4E00\u5C42\u4E00\u5C42\u53E0\u6258\u5230\u5C4B\u9876\u4E0B\u65B9\uFF0C\u6700\u540E\u5728\u6700\u4E0A\u5C42\u7684\u6881\u4E0A\u67B6\u8D77\u6258\u4F4F\u5C4B\u9876\u7684\u6AA9\u6761\uFF0C\u94FA\u597D\u693D\u5B50\u548C\u74E6\u7247\uFF0C\u5C4B\u9876\u5C31\u7ACB\u4F4F\u4E86\u3002\u6597\u62F1\u6728\u6784\u5EFA\u7B51\u72EC\u6709\u7684\u6838\u5FC3\u627F\u91CD\u4E0E\u88C5\u9970\u6784\u4EF6\uFF0C\u79F0
      \u201C\u6597\u79D1\u201D\uFF0C\u96C6\u529B\u5B66\u667A\u6167\u4E0E\u7F8E\u5B66\u610F\u8574\u4E8E\u4E00\u4F53\uFF0C\u662F\u4E2D\u5F0F\u53E4\u5EFA\u7B51\u7684\u7075\u9B42\u6240\u5728\u3002\u5B83\u7531\u6597\uFF08\u65B9\u5F62\u6728\u5757\uFF09\u3001\u62F1\uFF08\u5F13\u5F62\u6A2A\u6728\uFF09\u3001\u7FD8\uFF08\u659C\u5411\u6728\u4EF6\uFF09\u3001\u6602\uFF08\u957F\u6761\u5F62\u659C\u6728\uFF09\u7B49\u57FA\u7840\u90E8\u4EF6\u901A\u8FC7\u69AB\u536F\u54AC\u5408\u62FC\u63A5\u800C\u6210\uFF0C\u5C42\u5C42\u76F8\u53E0\u3001\u7EB5\u6A2A\u4EA4\u9519\uFF0C\u5F62\u6210\u4E00\u7EC4\u7EC4\u7CBE\u5DE7\u7684\u6784\u67B6\uFF0C\u4E00\u5934\u8854\u63A5\u5EFA\u7B51\u7684\u7ACB\u67F1\u4E0E\u6A2A\u6881\uFF0C\u4E00\u5934\u627F\u6258\u5C4B\u6A90\u7684\u91CD\u91CF\uFF0C\u5B9B\u5982\u5EFA\u7B51\u7684
      \u201C\u5173\u8282\u201D \u4E0E \u201C\u810A\u6881\u201D\u3002\u60AC\u5C71\u9876\uFF0C\u53C8\u79F0\u6311\u5C71\u3001\u51FA\u5C71\uFF0C\u5B8B\u4EE3\u300A\u8425\u9020\u6CD5\u5F0F\u300B\u4E2D\u79F0
      \u201C\u4E0D\u53A6\u4E24\u5934\u9020\u201D\uFF0C\u662F\u4E2D\u56FD\u4F20\u7EDF\u5EFA\u7B51\u4E2D\u6781\u5177\u4EE3\u8868\u6027\u7684\u4E24\u5761\u5C4B\u9876\u6837\u5F0F\u3002\u5176\u6700\u9C9C\u660E\u7684\u7279\u5F81\uFF0C\u4FBF\u662F\u5C4B\u9876\u4E24\u4FA7\u7684\u6AA9\u6728\u4E0E\u5C4B\u6A90\uFF0C\u5E76\u975E\u88AB\u5C71\u5899\u5C01\u88F9\uFF0C\u800C\u662F\u51CC\u7A7A\u60AC\u6311\u4E8E\u5C71\u5899\u4E4B\u5916\uFF0C\u5F62\u6210\u4E00\u9053\u98D8\u9038\u7684\u60AC\u5782\u6A90\u89D2\u3002\u677F\uFF0C\u90E8\u5206\u53E4\u5EFA\u8FD8\u4F1A\u70B9\u7F00\u60AC\u9C7C\u3001\u60F9\u8349\u7B49\u88C5\u9970\uFF0C\u517C\u5177\u5B9E\u7528\u4E0E\u96C5\u8DA3\u3002\u79C0\u624D\uFF0C\u524D\u9762\u5C31\u662F\u5BB6\u65CF\u7684\u65E7\u5B85\u697C\u4E86\r\n\u4FEE\u590D\u4E00\u4E8B\u5B9E\u5C5E\u4E0D\u6613\uFF0C\u4FD7\u8BDD\u8BF4\u7684\u597D\uFF0C\u201C\u672F\u4E1A\u6709\u4E13\u653B\u201D\uFF0C\u6211\u4E00\u5B9A\u5C3D\u529B\u5E2E\u52A9\u79C0\u624D\u5B8C\u6210\u4FEE\u590D\u5B85\u697C\u4E00\u4E8B\u79C0\u624D\u4E0D\u5FD8\u672C\uFF0C\u80AF\u613F\u4FEE\u590D\u8001\u5B85\uFF0C\u5374\u4E0D\u4E00\u5B9A\u5BF9\u8FD9\u571F\u6728\u4E4B\u4E8B\u4E86\u89E3\uFF0C\u4E0D\u5982\u8BA9\u6211\u6765\u7ED9\u79C0\u624D\u8BB2\u89E3\u8FD9\u8001\u5B85\u57FA\u7840\u77E5\u8BC6\u8BBE\u7F6E\u4ECB\u7ECD\u5B8C\u6BD5"
