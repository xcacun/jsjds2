  introduceImage: {fileID: 21300000, guid: 50344c76e6f9daa4dbd05a704b0e887c, type: 3}
  introduceText: "\u60AC\u5C71\u9876\uFF0C\u53C8\u79F0\u6311\u5C71\u3001\u51FA\u5C71\uFF0C\u5B8B\u4EE3\u300A\u8425\u9020\u6CD5\u5F0F\u300B\u4E2D\u79F0
    \u201C\u4E0D\u53A6\u4E24\u5934\u9020\u201D\uFF0C\u662F\u4E2D\u56FD\u4F20\u7EDF\u5EFA\u7B51\u4E2D\u6781\u5177\u4EE3\u8868\u6027\u7684\u4E24\u5761\u5C4B\u9876\u6837\u5F0F\u3002\u5176\u6700\u9C9C\u660E\u7684\u7279\u5F81\uFF0C\u4FBF\u662F\u5C4B\u9876\u4E24\u4FA7\u7684\u6AA9\u6728\u4E0E\u5C4B\u6A90\uFF0C\u5E76\u975E\u88AB\u5C71\u5899\u5C01\u88F9\uFF0C\u800C\u662F\u51CC\u7A7A\u60AC\u6311\u4E8E\u5C71\u5899\u4E4B\u5916\uFF0C\u5F62\u6210\u4E00\u9053\u98D8\u9038\u7684\u60AC\u5782\u6A90\u89D2\u3002\u677F\uFF0C\u90E8\u5206\u53E4\u5EFA\u8FD8\u4F1A\u70B9\u7F00\u60AC\u9C7C\u3001\u60F9\u8349\u7B49\u88C5\u9970\uFF0C\u517C\u5177\u5B9E\u7528\u4E0E\u96C5\u8DA3\u3002\n"
  introduceWhat: 1
