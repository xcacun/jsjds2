  introduceImage: {fileID: 21300000, guid: 170fbb36de42ebd418881e31b250f0dc, type: 3}
  introduceText: "\u6597\u62F1\u6728\u6784\u5EFA\u7B51\u72EC\u6709\u7684\u6838\u5FC3\u627F\u91CD\u4E0E\u88C5\u9970\u6784\u4EF6\uFF0C\u79F0
    \u201C\u6597\u79D1\u201D\uFF0C\u96C6\u529B\u5B66\u667A\u6167\u4E0E\u7F8E\u5B66\u610F\u8574\u4E8E\u4E00\u4F53\uFF0C\u662F\u4E2D\u5F0F\u53E4\u5EFA\u7B51\u7684\u7075\u9B42\u6240\u5728\u3002\u5B83\u7531\u6597\uFF08\u65B9\u5F62\u6728\u5757\uFF09\u3001\u62F1\uFF08\u5F13\u5F62\u6A2A\u6728\uFF09\u3001\u7FD8\uFF08\u659C\u5411\u6728\u4EF6\uFF09\u3001\u6602\uFF08\u957F\u6761\u5F62\u659C\u6728\uFF09\u7B49\u57FA\u7840\u90E8\u4EF6\u901A\u8FC7\u69AB\u536F\u54AC\u5408\u62FC\u63A5\u800C\u6210\uFF0C\u5C42\u5C42\u76F8\u53E0\u3001\u7EB5\u6A2A\u4EA4\u9519\uFF0C\u5F62\u6210\u4E00\u7EC4\u7EC4\u7CBE\u5DE7\u7684\u6784\u67B6\uFF0C\u4E00\u5934\u8854\u63A5\u5EFA\u7B51\u7684\u7ACB\u67F1\u4E0E\u6A2A\u6881\uFF0C\u4E00\u5934\u627F\u6258\u5C4B\u6A90\u7684\u91CD\u91CF\uFF0C\u5B9B\u5982\u5EFA\u7B51\u7684
    \u201C\u5173\u8282\u201D \u4E0E \u201C\u810A\u6881\u201D\u3002"
  introduceWhat: 3
