  introduceImage: {fileID: 21300000, guid: 0d764dd435e16de4697b681f86817752, type: 3}
  introduceText: "\u62AC\u6881\u5F0F\u67B6\u6784\u662F\u6728\u5934\u5EFA\u7B51\u91CC\u6700\u5E38\u7528\u7684\u627F\u91CD\u7ED3\u6784\uFF0C\u4E5F\u662F\u5927\u5B85\u9662\u8FD9\u7C7B\u5EFA\u7B51\u7684\u4E3B\u8981\u6784\u67B6\u65B9\u5F0F\uFF0C\u9760\u5C42\u5C42\u67B6\u8D77\u7684\u6728\u6881\u548C\u7ACB\u67F1\uFF0C\u6491\u8D77\u6574\u5EA7\u623F\u5B50\u7684\u5C4B\u9876\uFF0C\u4E0D\u7528\u5899\u4F53\u627F\u91CD\u3002\n\u5B83\u7684\u642D\u5EFA\u903B\u8F91\u7279\u522B\u6E05\u6670\uFF1A\u5148\u7ACB\u8D77\u4E00\u6839\u6839\u7AD6\u76F4\u7684\u6728\u67F1\uFF0C\u5728\u67F1\u5B50\u9876\u7AEF\u67B6\u4E0A\u6A2A\u5411\u7684\u6728\u6881\uFF0C\u4E0B\u5C42\u7684\u6881\u77ED\u3001\u4E0A\u5C42\u7684\u6881\u957F\uFF0C\u5728\u6BCF\u5C42\u6881\u7684\u4E24\u7AEF\u518D\u7ACB\u4E0A\u77EE\u4E00\u4E9B\u7684\u77ED\u67F1\uFF0C\u628A\u66F4\u957F\u7684\u6881\u67B6\u4E0A\u53BB\uFF0C\u8FD9\u6837\u4E00\u5C42\u4E00\u5C42\u53E0\u6258\u5230\u5C4B\u9876\u4E0B\u65B9\uFF0C\u6700\u540E\u5728\u6700\u4E0A\u5C42\u7684\u6881\u4E0A\u67B6\u8D77\u6258\u4F4F\u5C4B\u9876\u7684\u6AA9\u6761\uFF0C\u94FA\u597D\u693D\u5B50\u548C\u74E6\u7247\uFF0C\u5C4B\u9876\u5C31\u7ACB\u4F4F\u4E86\u3002"
  introduceWhat: 2
